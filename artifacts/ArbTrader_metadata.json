		"userdoc": {
			"kind": "user",
			"methods": {
				"arb(address,address,address,uint256,uint256)": {
					"notice": "Spend `ethIn` from this contract's balance. Reverts unless the contract's ETH balance ends at least `minProfit` higher than it started. buyPool == sellPool is allowed (for exploiting a pool with a stale/odd K)."
				},
				"bestAmount(address,address,uint256)": {
					"notice": "Ternary search for the profit-maximizing ETH input in [1, maxEth]. Profit is concave in the input for constant-product pools, so this works. Only meaningful for two DIFFERENT pools (a same-pool quote ignores that the first leg moves the pool before the second leg)."
				},
				"quoteProfit(address,address,uint256)": {
					"notice": "Profit (in wei, can be negative) of: ethIn -> token on buyPool -> ETH on sellPool. Reverts in a pool are reported as a hugely negative profit instead of reverting."
				},
				"reserves(address,address)": {
					"notice": "Raw reserves of a pool: (ETH, token). Spot price = eth / token."
				}
			},
			"notice": "Buys a token on `buyPool` with FAKEETH and sells it on `sellPool`, all in one transaction. If the round trip is not profitable the whole tx reverts, so a competing trade landing first costs you only gas.",
			"version": 1
		}
