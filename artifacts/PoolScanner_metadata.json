				"buyCurve(address,uint256[])": {
					"notice": "Quotes for one pool at several sizes, to check how its price curve behaves (for example, whether it charges a fee)."
				},
				"scan(address[],address,uint256,uint256)": {
					"notice": "One call for a whole list of pools that trade the same token. For pool i: FakeETH balance, token balance, tokens received for `ethProbe` wei of FakeETH, and FakeETH received for selling `tokenProbe` raw tokens. A pool whose quote reverts reports 0 for that quote."
				}
